[MAIN]
ignore=instance

[MESSAGES CONTROL]
# Los repositorios y servicios tienen un solo método público a propósito.
disable=too-few-public-methods

[DESIGN]
# Las entidades del dominio son dataclasses con 8 campos.
max-attributes=10
max-args=6
max-positional-arguments=6

[FORMAT]
max-line-length=100
